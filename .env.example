# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only secret key (Project Settings → API Keys → Secret keys)
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Supabase Postgres (Frankfurt) — from the "Connect" button in the dashboard.
# Pooled connection (Transaction pooler, port 6543) for the app:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# Direct / Session pooler connection (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
